# Copy to .env.local and fill in. All are optional for local dev.

# Web3Forms access key — receives every submitted lead by email (client-side).
# Web3Forms keys are safe to expose in the browser. Get one at https://web3forms.com.
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key

# Optional: legacy Make.com webhook (server proxy at /api/lead). Not used while
# forms post directly to Web3Forms; kept for a future switch of delivery target.
MAKE_WEBHOOK_URL=

# Analytics (client). Leave blank to disable; the snippets only load when set.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
